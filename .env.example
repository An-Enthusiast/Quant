# Template for local broker credentials. Copy this file to `.env` (which is
# gitignored -- see .gitignore) and fill in real values there. NEVER put
# real values in this file, and NEVER commit a `.env` file.
#
#   cp .env.example .env
#   # edit .env with your real Shoonya credentials
#   set -a && source .env && set +a
#   python scripts/shoonya_live_smoke_test.py --yes-hit-live-shoonya
#
# See docs/WHITEPAPER.md ("Phase 2 -- live streaming") for what each value
# is and where it comes from (Finvasia/Shoonya account + API app).
#
# Reminder: these credentials must only ever be used for market-data login
# and touchline subscription. This project never places, modifies, or
# cancels orders -- see CLAUDE.md and docs/WHITEPAPER.md's safety section.

SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_TOTP_SECRET=
SHOONYA_VENDOR_CODE=
SHOONYA_API_KEY=
SHOONYA_IMEI=
